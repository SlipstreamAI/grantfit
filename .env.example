# Local demo passwords created by scripts/bootstrap_local.sh.
# They are for a laptop database only. Do not reuse them in production.

# Read-only role used by the web demo and `grantfit match`.
DATABASE_URL=postgresql://grantfit_demo:grantfit_local_dev@127.0.0.1:5432/grantfit
GRANTFIT_DEMO_DATABASE_URL=postgresql://grantfit_demo:grantfit_local_dev@127.0.0.1:5432/grantfit

# Worker role. Can upsert notices, spend the request budget, and write the HTTP cache.
GRANTFIT_DATABASE_URL=postgresql://grantfit_worker:grantfit_local_dev@127.0.0.1:5432/grantfit

# Supabase Edge Function. Set these in the hosted project, not in git.
# supabase secrets set GRANTFIT_SYNC_SECRET=...
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
GRANTFIT_SYNC_SECRET=

# Grants.gov search2 and fetchOpportunity do not use an API key.
